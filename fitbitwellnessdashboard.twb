          </datasources>
          <datasource-dependencies datasource='federated.04pismq0wx00b916iq41b1idstui'>
            <column caption='Calorie Gap' datatype='real' name='[Calculation_817121883922366464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calories ]) -&#13;&#10;avg([Diet details - Split 1])' />
            </column>
            <column caption='Calories' datatype='real' name='[Calories ]' role='measure' type='quantitative' />
            <column caption='Max Calories' datatype='integer' datatype-customized='true' name='[Diet details - Split 1]' role='dimension' type='ordinal' user:SplitFieldIndex='3' user:SplitFieldOrigin='[federated.04pismq0wx00b916iq41b1idstui].[Diet details]'>
              <calculation class='tableau' formula='INT(TRIM( SPLIT( SPLIT( SPLIT( [Diet details], &quot;Max&quot;, 2 ), &quot;:&quot;, 2 ), &quot;kcal&quot;, 1 ) ))' />
