    <worksheet name='Chart:Engagment by Category'>
      <table>
        <view>
          <datasources>
            <datasource caption='Fitbit_Activities+' name='federated.04pismq0wx00b916iq41b1idstui' />
          </datasources>
          <datasource-dependencies datasource='federated.04pismq0wx00b916iq41b1idstui'>
            <column caption='Activity Date' datatype='date' name='[ActivityDate]' role='dimension' type='ordinal' />
            <column caption='Latest Activity Date' datatype='date' name='[Calculation_498492209942228992]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED :MAX([ActivityDate])}' />
            </column>
            <column caption='Days from latest activity' datatype='integer' name='[Calculation_498492209942708225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[ActivityDate],[Calculation_498492209942228992])' />
            </column>
            <column caption='Recent 7 days average steps' datatype='real' name='[Calculation_498492209943773186]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [User_ID]: AVG(IF [Calculation_498492209942708225]&gt;=0 AND [Calculation_498492209942708225]&lt;=6 THEN [Steps] END )}' />
            </column>
            <column caption='Previous 7 days average steps' datatype='real' name='[Calculation_498492209945161731]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [User_ID]: AVG(IF [Calculation_498492209942708225]&gt;=7 AND [Calculation_498492209942708225]&lt;=13 THEN [Steps] END )}' />
            </column>
            <column caption='Activity change %' datatype='real' name='[Calculation_498492209945759748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_498492209945161731]) or&#13;&#10; [Calculation_498492209945161731]=0&#13;&#10;THEN&#13;&#10;NULL&#13;&#10;ELSE&#13;&#10;(&#13;&#10;[Calculation_498492209943773186]-&#13;&#10;[Calculation_498492209945161731])&#13;&#10;/&#13;&#10;[Calculation_498492209945161731]&#13;&#10;END' />
            </column>
            <column caption='Engagment Status' datatype='string' name='[Calculation_498492209947607045]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_498492209945759748]) THEN&#13;&#10;&quot;Insufficient History&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_498492209945759748] ) &lt;= -0.20 THEN&#13;&#10;&quot;Declining&quot;&#13;&#10;&#13;&#10;ELSEIF ([Calculation_498492209945759748] ) &gt;= 0.20 THEN&#13;&#10;&quot;Improving&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;&quot;Stable&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[Steps]' role='measure' type='quantitative' />
            <column caption='User ID' datatype='integer' name='[User_ID]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_498492209945759748]' derivation='Avg' name='[avg:Calculation_498492209945759748:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_498492209947607045]' derivation='None' name='[none:Calculation_498492209947607045:nk]' pivot='key' type='nominal' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
